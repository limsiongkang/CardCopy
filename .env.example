# Copy this file to ".env" and fill in the values.
# The .env file is never committed and is not read by anything but this tool.

# ---- What to call the Google Sheet --------------------------------------
# The sheet will be named "<CLIENT_NAME> - Competitor Intel".
CLIENT_NAME=Cardcopy

# ---- Proxy ---------------------------------------------------------------
# Paste the details your proxy provider gave you.
# Leave PROXY_SERVER empty to scrape from this machine's own connection.
# Example: PROXY_SERVER=http://gate.smartproxy.com:7000
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# ---- Email alerts --------------------------------------------------------
# GMAIL_APP_PASSWORD is a 16-character app password from
# https://myaccount.google.com/apppasswords - NOT your normal Google password.
# It requires 2-step verification to be switched on first.
GMAIL_ADDRESS=limsiongkang@gmail.com
GMAIL_APP_PASSWORD=
ALERT_RECIPIENT=limsiongkang@gmail.com

# ---- Google Sheets -------------------------------------------------------
# Filename of the service-account key, expected in the secrets folder.
GOOGLE_CREDENTIALS_FILENAME=google-service-account.json

# ---- Scraping behaviour --------------------------------------------------
PAGE_TIMEOUT_MS=60000
DELAY_BETWEEN_URLS=3
MAX_RETRIES=2
# Set to true only if a competitor site puts you behind a Cloudflare check.
# It works, but it makes every request noticeably slower.
SOLVE_CLOUDFLARE=false
